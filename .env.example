# THE ONE env template for this repo (Aragamago, Maxayauwi, JARVIS). TEMPLATE ONLY, NO REAL VALUES.
# Do not create other .env.example / secrets template files — add new keys here.
# Production: Railway and Cursor inject these as environment variables; no .env file is needed.
# Local dev: keep ONE filled copy outside git (default: Obsidian Vault/Agents/Secrets/master.env,
# override with ENV_PATH). runtime_env.load_local_env() is the only loader that reads it.

# ═════════════════════════════════════════════════════════════════════════════
# 1. CURSOR CLOUD AGENT  →  cursor.com/dashboard → Cloud Agents → Secrets (scope: ai-agents)
#    Lets the agent inspect your infrastructure. Used read-only unless you approve a change.
# ═════════════════════════════════════════════════════════════════════════════
RAILWAY_API_TOKEN=            # railway.com → Account Settings → Tokens → create (name: cursor-jarvis-readonly)

# ═════════════════════════════════════════════════════════════════════════════
# 2. ARAGAMAGO — Telegram bot  →  Railway service that builds from repo root (Dockerfile)
# ═════════════════════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=           # REQUIRED. Telegram @BotFather → /mybots → Aragamago → API Token. One service only, or Telegram returns 409.

# AI providers (at least one). Tried in AI_PROVIDER_ORDER.
OPENROUTER_API_KEY=           # openrouter.ai → Keys
OPENAI_API_KEY=               # platform.openai.com → API keys (also used for Pinecone embeddings)
GEMINI_API_KEY=               # aistudio.google.com → Get API key (needed for voice-note transcription)
AI_PROVIDER_ORDER=openrouter,openai,gemini
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.0-flash

# Voice replies (optional)
ELEVENLABS_API_KEY=           # elevenlabs.io → Profile → API key
ELEVENLABS_VOICE_ID=

# Memory (optional)
PINECONE_API_KEY=             # app.pinecone.io → API Keys
PINECONE_HOST=https://aragamago-brain-flmynca.svc.aped-4627-b74a.pinecone.io
PINECONE_INDEX_NAME=aragamago-brain
SUPABASE_URL=                 # supabase.com → Project → Settings → API
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=          # server-only; never put in a browser app

# Google Tasks / Calendar / Sheets (optional). Paste JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=  # Sheets
GOOGLE_TOKEN_JSON=            # Tasks + Calendar (OAuth user token)
GOOGLE_CREDENTIALS_JSON=      # only to generate GOOGLE_TOKEN_JSON
GOOGLE_SHEET_ID=
GOOGLE_SHEET_URL=             # alternative to GOOGLE_SHEET_ID
GOOGLE_CALENDAR_ID=primary

# /rss3status diagnostics (optional; copy from the Linode node's env)
NODE_CONFIG_DISCOVERY_SERVER_ENDPOINT=
NODE_CONFIG_DISCOVERY_SERVER_ACCESS_TOKEN=
NODE_CONFIG_DISCOVERY_OPERATOR_EVM_ADDRESS=
NODE_CONFIG_DISCOVERY_OPERATOR_SIGNATURE=
NODE_DATABASE_URL=

# ═════════════════════════════════════════════════════════════════════════════
# 3. MAXAYAUWI — RSS3 comm agent  →  Railway service with Root Directory = rss3-comm-agent
# ═════════════════════════════════════════════════════════════════════════════
NEYNAR_API_KEY=               # dev.neynar.com → App → API key (Farcaster posting)
NEYNAR_SIGNER_UUID=           # dev.neynar.com → Signers
PUBLIC_AGENT_URL=https://rss3-comm-agent-production.up.railway.app
RSS3_NODE_ADDRESS=0x0063951De34a75c25279cFe3C212F4855125Fd8f
RSS3_FEED_ACCOUNT=            # defaults to RSS3_NODE_ADDRESS
RSS3_NODE_PUBLIC_URL=http://web3.adbongo.io:8080
RSS3_GLOBAL_INDEXER_URL=https://gi.rss3.io
YOUTUBE_API_KEY=              # optional: console.cloud.google.com → YouTube Data API v3
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_URL=
YOUTUBE_POLL_INTERVAL_MS=0

# ═════════════════════════════════════════════════════════════════════════════
# 4. JARVIS voice app  →  future host (not deployed yet)
# ═════════════════════════════════════════════════════════════════════════════
JARVIS_ACCESS_CODE=           # your phone unlock passphrase; pick something long
JARVIS_SESSION_SECRET=        # random 32+ chars: openssl rand -hex 32
OPENAI_API_KEY=               # same key as above; enables Realtime voice. Server-side only.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=verse
